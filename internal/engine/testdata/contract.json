{
  "workflow": {
    "name": "contract-check",
    "steps": [
      {
        "id": "s1",
        "task": "send.email",
        "type": "normal",
        "config": {
          "to": "a@b.com"
        },
        "retry": {
          "max_attempts": 3,
          "strategy": "exponential",
          "initial_delay": 1000000000,
          "max_delay": 30000000000
        },
        "timeout": 5000000000
      },
      {
        "id": "s2",
        "task": "send.push",
        "type": "normal",
        "depends_on": [
          "s1"
        ]
      }
    ],
    "idempotency_key": "input.transactionId",
    "singleton": {
      "mode": "skip",
      "key": "input.subscriberId"
    }
  },
  "task_payload": {
    "task_id": "t1",
    "run_id": "r1",
    "step_id": "s1",
    "iteration": 2,
    "attempt": 1,
    "input": {
      "foo": "bar"
    }
  }
}
