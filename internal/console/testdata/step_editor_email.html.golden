
<div id="workflow-step-editor" data-signals="{wfPreviewTmpl:&#39;Email body {{payload.x}}&#39;,wfPreviewPayload:'{}',condRowCount:1}">
  
  
  <div class="wf-step-editor-header">
    <h3 class="console-card-title">email — <code>email-1</code></h3>
  </div>
  
  <form method="POST" action="/console/api/workflows/wf-golden/steps/email-1/save">
    <input type="hidden" name="csrf_token" value="csrf-golden">
    
    <div class="form-row">
      <label class="form-label" for="cv-subject">Subject</label>
      <input class="console-input" type="text" id="cv-subject" name="subject"
             value="Email subject">
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-from">From address <span class="form-hint">(optional — overrides integration default)</span></label>
      <input class="console-input" type="text" id="cv-from" name="from"
             placeholder="sender@example.com"
             value="">
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-reply-to">Reply-To address <span class="form-hint">(optional)</span></label>
      <input class="console-input" type="text" id="cv-reply-to" name="reply_to"
             placeholder="support@example.com"
             value="">
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-reply">
        <input type="checkbox" id="cv-reply" name="reply" value="on">
        Accept replies
      </label>
      <span class="form-hint">Sends with a tokenized reply address; a reply comes back to this environment's webhook endpoints as an <code>email.reply</code> event. Overrides Reply-To. Needs a verified inbound domain.</span>
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-editor-type-trigger">Editor type</label>
      
<div class="ui-select" id="cv-editor-type" data-signals="{uiSelOpen_cv_editor_type: false, uiSelFilter_cv_editor_type: &#39;&#39;, cvEditorType: &#34;&#34;}"
     data-on:click__outside="$uiSelOpen_cv_editor_type = false">

  
  <input type="hidden" name="editor_type" data-attr:value="$cvEditorType">
  

  <button type="button" class="ui-select-trigger" id="cv-editor-type-trigger"
          aria-haspopup="listbox" aria-controls="cv-editor-type-popover"
          data-attr:aria-expanded="$uiSelOpen_cv_editor_type ? &#39;true&#39; : &#39;false&#39;"
          data-on:click="$uiSelOpen_cv_editor_type = !$uiSelOpen_cv_editor_type"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cv_editor_type = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_cv_editor_type = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_cv_editor_type = false)">
    <span class="ui-select-trigger-label" data-text="$cvEditorType === &#34;block&#34; ? &#34;Block (plain text)&#34; : ($cvEditorType === &#34;html&#34; ? &#34;HTML&#34; : (&#34;Editor type&#34;))">Editor type</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="cv-editor-type-popover" role="listbox"
       aria-label="Editor type"
       data-show="$uiSelOpen_cv_editor_type">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="block"
           data-attr:aria-selected="($cvEditorType === &#34;block&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$cvEditorType = &#34;block&#34;; $uiSelOpen_cv_editor_type = false; $uiSelFilter_cv_editor_type = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $cvEditorType = &#34;block&#34;; $uiSelOpen_cv_editor_type = false; $uiSelFilter_cv_editor_type = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cv_editor_type = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Block (plain text)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$cvEditorType === &#34;block&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="html"
           data-attr:aria-selected="($cvEditorType === &#34;html&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$cvEditorType = &#34;html&#34;; $uiSelOpen_cv_editor_type = false; $uiSelFilter_cv_editor_type = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $cvEditorType = &#34;html&#34;; $uiSelOpen_cv_editor_type = false; $uiSelFilter_cv_editor_type = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cv_editor_type = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">HTML</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$cvEditorType === &#34;html&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      
    </div>
  </div>
</div>

    </div>
    <div class="form-row">
      <label class="form-label" for="cv-layout-key">Layout key <span class="form-hint">(optional)</span></label>
      <input class="console-input" type="text" id="cv-layout-key" name="layout_key"
             placeholder="main-layout"
             value="">
    </div>
    
    
    
    
<div class="wf-preview-split">
  <div class="wf-preview-split-editor">
    <div class="form-row">
      <label class="form-label" for="cv-body">Body</label>
      <textarea class="console-input wf-preview-textarea" id="cv-body" name="body" rows="6"
                data-bind="wfPreviewTmpl"
                data-on:input__debounce.400ms="@get('/console/api/fragments/step-preview')">Email body {{payload.x}}</textarea>
    </div>
    <div class="form-row">
      <label class="form-label" for="wf-preview-payload">Sample payload (JSON)</label>
      <textarea class="console-input console-input-mono" id="wf-preview-payload" rows="3"
                data-bind="wfPreviewPayload"
                data-on:input__debounce.400ms="@get('/console/api/fragments/step-preview')">{}</textarea>
    </div>
  </div>
  <div class="wf-preview-split-preview">
    <p class="form-label wf-preview-label">Preview</p>
    <p class="wf-preview-hint console-lede">Variables: <code>{{payload.*}}</code>, <code>{{subscriber.firstName}}</code></p>
    <div data-on:load="@get('/console/api/fragments/step-preview')">
      <div id="step-preview-pane" class="step-preview-pane">
        <pre class="step-preview-output wf-code-block"></pre>
      </div>
    </div>
  </div>
</div>

    <div class="form-row">
      <label class="form-label" for="cv-html-body">HTML body <span class="form-hint">(optional)</span></label>
      <textarea class="console-input" id="cv-html-body" name="html_body" rows="6"
                placeholder="<p>{{payload.text}}</p>"></textarea>
      <span class="form-hint">When set, the email carries both: Body above as plain text, this as HTML. Values are HTML-escaped; use <code>{{raw "payload.field"}}</code> for a field that is already HTML.</span>
    </div>
    
    