
<div id="workflow-step-editor" data-signals="{wfPreviewTmpl:&#39;&#39;,wfPreviewPayload:'{}',condRowCount:1}">
  
  
  <div class="wf-step-editor-header">
    <h3 class="console-card-title">throttle — <code>throttle-1</code></h3>
  </div>
  
  <form method="POST" action="/console/api/workflows/wf-golden/steps/throttle-1/save">
    <input type="hidden" name="csrf_token" value="csrf-golden">
    
    <div class="form-row">
      <label class="form-label" for="cv-limit">Limit</label>
      <input class="console-input" type="number" id="cv-limit" name="limit" min="1"
             value="5">
      <p class="form-hint">Maximum number of runs allowed within the window.</p>
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-windowSec">Window (seconds)</label>
      <input class="console-input" type="number" id="cv-windowSec" name="windowSec" min="1"
             value="3600">
      <p class="form-hint">Fixed window duration in seconds (e.g. 3600 = 1 hour).</p>
    </div>
    <div class="form-row">
      <label class="form-label" for="cv-throttleKey">Throttle key (optional)</label>
      <input class="console-input console-input-mono" type="text" id="cv-throttleKey" name="throttleKey"
             placeholder="payload.check"
             value="">
      <p class="form-hint">Payload dot-path giving each value its own budget, e.g. <code>payload.check</code>. Leave blank for one shared budget per subscriber.</p>
    </div>
    
    