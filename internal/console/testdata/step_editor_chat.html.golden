          data-on:click="$uiSelOpen_cond_operator_0 = !$uiSelOpen_cond_operator_0"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_operator_0 = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_cond_operator_0 = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_cond_operator_0 = false)">
    <span class="ui-select-trigger-label" data-text="$condOperator0 === &#34;EQUAL&#34; ? &#34;equals&#34; : ($condOperator0 === &#34;NOT_EQUAL&#34; ? &#34;not equals&#34; : ($condOperator0 === &#34;LARGER&#34; ? &#34;greater than&#34; : ($condOperator0 === &#34;SMALLER&#34; ? &#34;less than&#34; : ($condOperator0 === &#34;LARGER_EQUAL&#34; ? &#34;greater or equal&#34; : ($condOperator0 === &#34;SMALLER_EQUAL&#34; ? &#34;less or equal&#34; : ($condOperator0 === &#34;IN&#34; ? &#34;in&#34; : ($condOperator0 === &#34;NOT_IN&#34; ? &#34;not in&#34; : ($condOperator0 === &#34;ALL_IN&#34; ? &#34;all in&#34; : ($condOperator0 === &#34;ANY_IN&#34; ? &#34;any in&#34; : ($condOperator0 === &#34;BETWEEN&#34; ? &#34;between&#34; : ($condOperator0 === &#34;NOT_BETWEEN&#34; ? &#34;not between&#34; : ($condOperator0 === &#34;LIKE&#34; ? &#34;contains&#34; : ($condOperator0 === &#34;NOT_LIKE&#34; ? &#34;not contains&#34; : ($condOperator0 === &#34;IS_DEFINED&#34; ? &#34;is defined&#34; : (&#34;Operator&#34;)))))))))))))))">Operator</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
