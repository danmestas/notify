        </div>
        <div class="form-row wf-condition-value">
          <label class="form-label" for="cond-value-9">Value</label>
          <input class="console-input" type="text" id="cond-value-9" name="cond_value_9"
                 data-signals="{condValue9:&#39;&#39;}" data-bind="condValue9"
                 placeholder="premium" value="">
          <p class="form-hint">Comma-separated for in / all in / any in; min,max for between.</p>
        </div>
        <div class="form-row wf-condition-remove">
          <button type="button" class="btn btn-ghost btn-icon wf-condition-remove-btn"
                  aria-label="Remove condition"
                  data-on:click="$condRowCount = ($condRowCount &gt; 1 ? $condRowCount - 1 : 1)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>
        </div>
      </div>
      
      <div class="wf-conditions-actions">
        <button type="button" class="btn btn-outline wf-condition-add-btn"
                data-show="$condRowCount < 10"
                data-on:click="$condRowCount = ($condRowCount <  10  ? $condRowCount + 1 :  10 )"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
 Add condition</button>
      </div>
    </fieldset>
    <div class="console-slideover-actions">
      <button type="submit" class="btn btn-primary">Save step</button>
    </div>
  </form>
  
  
</div>
