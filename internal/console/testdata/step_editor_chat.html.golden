           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $condOn0 = &#34;subscriber&#34;; $uiSelOpen_cond_on_0 = false; $uiSelFilter_cond_on_0 = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_on_0 = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Subscriber</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$condOn0 === &#34;subscriber&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="payload"
           data-attr:aria-selected="($condOn0 === &#34;payload&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$condOn0 = &#34;payload&#34;; $uiSelOpen_cond_on_0 = false; $uiSelFilter_cond_on_0 = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $condOn0 = &#34;payload&#34;; $uiSelOpen_cond_on_0 = false; $uiSelFilter_cond_on_0 = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_on_0 = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Payload</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$condOn0 === &#34;payload&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      
    </div>
  </div>
</div>

        </div>
        <div class="form-row wf-condition-field">
          <label class="form-label" for="cond-field-0">Field</label>
          <input class="console-input" type="text" id="cond-field-0" name="cond_field_0"
                 data-signals="{condField0:&#39;&#39;}" data-bind="condField0"
                 placeholder="data.plan" value="">
        </div>
        <div class="form-row wf-condition-operator">
          <label class="form-label" for="cond-operator-0-trigger">Operator</label>
          
<div class="ui-select" id="cond-operator-0" data-signals="{uiSelOpen_cond_operator_0: false, uiSelFilter_cond_operator_0: &#39;&#39;, condOperator0: &#34;&#34;}"
     data-on:click__outside="$uiSelOpen_cond_operator_0 = false">

  
