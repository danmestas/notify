
<div id="workflow-step-editor" data-signals="{wfPreviewTmpl:&#39;Chat body {{payload.x}}&#39;,wfPreviewPayload:'{}',condRowCount:1}">
  
  
  <div class="wf-step-editor-header">
    <h3 class="console-card-title">chat — <code>chat-1</code></h3>
  </div>
  
  <form method="POST" action="/console/api/workflows/wf-golden/steps/chat-1/save">
    <input type="hidden" name="csrf_token" value="csrf-golden">
    
    
<div class="wf-preview-split">
  <div class="wf-preview-split-editor">
    <div class="form-row">
      <label class="form-label" for="cv-body">Message</label>
      <textarea class="console-input wf-preview-textarea" id="cv-body" name="body" rows="4"
                data-bind="wfPreviewTmpl"
                data-on:input__debounce.400ms="@get('/console/api/fragments/step-preview')">Chat body {{payload.x}}</textarea>
    </div>
    <div class="form-row">
      <label class="form-label" for="wf-preview-payload">Sample payload (JSON)</label>
      <textarea class="console-input console-input-mono" id="wf-preview-payload" rows="3"
                data-bind="wfPreviewPayload"
                data-on:input__debounce.400ms="@get('/console/api/fragments/step-preview')">{}</textarea>
    </div>
  </div>
  <div class="wf-preview-split-preview">
    <p class="form-label wf-preview-label">Preview</p>
    <p class="wf-preview-hint console-lede">Variables: <code>{{payload.*}}</code>, <code>{{subscriber.firstName}}</code></p>
    <div data-on:load="@get('/console/api/fragments/step-preview')">
      <div id="step-preview-pane" class="step-preview-pane">
        <pre class="step-preview-output wf-code-block"></pre>
      </div>
    </div>
  </div>
</div>

    
    <fieldset class="wf-conditions">
      <legend class="form-label wf-conditions-legend"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 5 3-3M2 22l3-3m4.5-12L7 9.5a2.12 2.12 0 0 0 0 3L9 14.5a2.12 2.12 0 0 0 3 0l2.5-2.5m0 0 2.5-2.5a2.12 2.12 0 0 0 0-3L15 4a2.12 2.12 0 0 0-3 0L9.5 6.5M7 12l-2 2m12-2 2 2"/></svg>
 When should this step run?</legend>
      <p class="console-lede wf-conditions-hint">Leave conditions empty to always run this step.</p>
      <div class="form-row">
        <label class="form-label" for="cond-combinator-trigger">Match</label>
        
<div class="ui-select" id="cond-combinator" data-signals="{uiSelOpen_cond_combinator: false, uiSelFilter_cond_combinator: &#39;&#39;, condCombinator: &#34;AND&#34;}"
     data-on:click__outside="$uiSelOpen_cond_combinator = false">

  
  <input type="hidden" name="cond_combinator" data-attr:value="$condCombinator">
  

  <button type="button" class="ui-select-trigger" id="cond-combinator-trigger"
          aria-haspopup="listbox" aria-controls="cond-combinator-popover"
          data-attr:aria-expanded="$uiSelOpen_cond_combinator ? &#39;true&#39; : &#39;false&#39;"
          data-on:click="$uiSelOpen_cond_combinator = !$uiSelOpen_cond_combinator"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_combinator = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_cond_combinator = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_cond_combinator = false)">
    <span class="ui-select-trigger-label" data-text="$condCombinator === &#34;AND&#34; ? &#34;All conditions (AND)&#34; : ($condCombinator === &#34;OR&#34; ? &#34;Any condition (OR)&#34; : (&#34;Match&#34;))">Match</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="cond-combinator-popover" role="listbox"
       aria-label="Match"
       data-show="$uiSelOpen_cond_combinator">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="AND"
           data-attr:aria-selected="($condCombinator === &#34;AND&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$condCombinator = &#34;AND&#34;; $uiSelOpen_cond_combinator = false; $uiSelFilter_cond_combinator = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $condCombinator = &#34;AND&#34;; $uiSelOpen_cond_combinator = false; $uiSelFilter_cond_combinator = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_combinator = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">All conditions (AND)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$condCombinator === &#34;AND&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="OR"
           data-attr:aria-selected="($condCombinator === &#34;OR&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$condCombinator = &#34;OR&#34;; $uiSelOpen_cond_combinator = false; $uiSelFilter_cond_combinator = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $condCombinator = &#34;OR&#34;; $uiSelOpen_cond_combinator = false; $uiSelFilter_cond_combinator = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_combinator = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Any condition (OR)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$condCombinator === &#34;OR&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      
    </div>
  </div>
</div>

      </div>
      
      
      <div class="wf-condition-row">
        <div class="form-row wf-condition-on">
          <label class="form-label" for="cond-on-0-trigger">On</label>
          
<div class="ui-select" id="cond-on-0" data-signals="{uiSelOpen_cond_on_0: false, uiSelFilter_cond_on_0: &#39;&#39;, condOn0: &#34;&#34;}"
     data-on:click__outside="$uiSelOpen_cond_on_0 = false">

  
  <input type="hidden" name="cond_on_0" data-attr:value="$condOn0">
  

  <button type="button" class="ui-select-trigger" id="cond-on-0-trigger"
          aria-haspopup="listbox" aria-controls="cond-on-0-popover"
          data-attr:aria-expanded="$uiSelOpen_cond_on_0 ? &#39;true&#39; : &#39;false&#39;"
          data-on:click="$uiSelOpen_cond_on_0 = !$uiSelOpen_cond_on_0"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_cond_on_0 = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_cond_on_0 = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_cond_on_0 = false)">
    <span class="ui-select-trigger-label" data-text="$condOn0 === &#34;subscriber&#34; ? &#34;Subscriber&#34; : ($condOn0 === &#34;payload&#34; ? &#34;Payload&#34; : (&#34;On&#34;))">On</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="cond-on-0-popover" role="listbox"
       aria-label="On"
       data-show="$uiSelOpen_cond_on_0">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="subscriber"
           data-attr:aria-selected="($condOn0 === &#34;subscriber&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
