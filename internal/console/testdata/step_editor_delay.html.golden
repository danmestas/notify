          data-on:click="$uiSelOpen_delay_unit = !$uiSelOpen_delay_unit"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_unit = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_delay_unit = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_delay_unit = false)">
    <span class="ui-select-trigger-label" data-text="$delayUnit === &#34;seconds&#34; ? &#34;Seconds&#34; : ($delayUnit === &#34;minutes&#34; ? &#34;Minutes&#34; : ($delayUnit === &#34;hours&#34; ? &#34;Hours&#34; : ($delayUnit === &#34;days&#34; ? &#34;Days&#34; : ($delayUnit === &#34;weeks&#34; ? &#34;Weeks&#34; : ($delayUnit === &#34;months&#34; ? &#34;Months (30 days)&#34; : (&#34;Unit&#34;))))))">Unit</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="delay-unit-popover" role="listbox"
       aria-label="Unit"
       data-show="$uiSelOpen_delay_unit">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="seconds"
           data-attr:aria-selected="($delayUnit === &#34;seconds&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$delayUnit = &#34;seconds&#34;; $uiSelOpen_delay_unit = false; $uiSelFilter_delay_unit = &#39;&#39;"
