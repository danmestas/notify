
<div id="workflow-step-editor" data-signals="{wfPreviewTmpl:&#39;&#39;,wfPreviewPayload:'{}',condRowCount:1}">
  
  
  <div class="wf-step-editor-header">
    <h3 class="console-card-title">delay — <code>delay-1</code></h3>
  </div>
  
  <form method="POST" action="/console/api/workflows/wf-golden/steps/delay-1/save">
    <input type="hidden" name="csrf_token" value="csrf-golden">
    
    <div class="form-row">
      <label class="form-label" for="delay-type-trigger">Delay type</label>
      
<div class="ui-select" id="delay-type" data-signals="{uiSelOpen_delay_type: false, uiSelFilter_delay_type: &#39;&#39;, delayType: &#34;regular&#34;}"
     data-on:click__outside="$uiSelOpen_delay_type = false">

  
  <input type="hidden" name="type" data-attr:value="$delayType">
  

  <button type="button" class="ui-select-trigger" id="delay-type-trigger"
          aria-haspopup="listbox" aria-controls="delay-type-popover"
          data-attr:aria-expanded="$uiSelOpen_delay_type ? &#39;true&#39; : &#39;false&#39;"
          data-on:click="$uiSelOpen_delay_type = !$uiSelOpen_delay_type"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_type = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_delay_type = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_delay_type = false)">
    <span class="ui-select-trigger-label" data-text="$delayType === &#34;regular&#34; ? &#34;Regular (fixed duration)&#34; : ($delayType === &#34;scheduled&#34; ? &#34;Scheduled (calendar)&#34; : ($delayType === &#34;dynamic&#34; ? &#34;Dynamic (from payload)&#34; : (&#34;Delay type&#34;)))">Delay type</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="delay-type-popover" role="listbox"
       aria-label="Delay type"
       data-show="$uiSelOpen_delay_type">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="regular"
           data-attr:aria-selected="($delayType === &#34;regular&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$delayType = &#34;regular&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $delayType = &#34;regular&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_type = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Regular (fixed duration)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$delayType === &#34;regular&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="scheduled"
           data-attr:aria-selected="($delayType === &#34;scheduled&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$delayType = &#34;scheduled&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $delayType = &#34;scheduled&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_type = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Scheduled (calendar)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$delayType === &#34;scheduled&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="dynamic"
           data-attr:aria-selected="($delayType === &#34;dynamic&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$delayType = &#34;dynamic&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $delayType = &#34;dynamic&#34;; $uiSelOpen_delay_type = false; $uiSelFilter_delay_type = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_type = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Dynamic (from payload)</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$delayType === &#34;dynamic&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      
    </div>
  </div>
</div>

    </div>
    <div data-show="$delayType === 'regular'">
      <div class="form-row">
        <label class="form-label" for="cv-amount">Amount</label>
        <input class="console-input" type="number" id="cv-amount" name="amount" min="1"
               value="5">
      </div>
      <div class="form-row">
        <label class="form-label" for="delay-unit-trigger">Unit</label>
        
<div class="ui-select" id="delay-unit" data-signals="{uiSelOpen_delay_unit: false, uiSelFilter_delay_unit: &#39;&#39;, delayUnit: &#34;hours&#34;}"
     data-on:click__outside="$uiSelOpen_delay_unit = false">

  
  <input type="hidden" name="unit" data-attr:value="$delayUnit">
  

  <button type="button" class="ui-select-trigger" id="delay-unit-trigger"
