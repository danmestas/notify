      </div>
    </div>
    <div data-show="$delayType === 'scheduled'">
      <div class="form-row">
        <label class="form-label" for="cv-at-time">At time (UTC)</label>
        <input class="console-input" type="time" id="cv-at-time" name="atTime"
               value="">
        <p class="form-hint">Time of day in 24-hour UTC (e.g. <code>09:00</code>). The step waits until the next matching day at this time.</p>
      </div>
      <div class="form-row">
        <span class="form-label">On week days</span>
        <div class="checkbox-row">
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="MON">
            MON
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="TUE">
            TUE
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="WED">
            WED
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="THU">
            THU
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="FRI">
            FRI
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="SAT">
            SAT
          </label>
          
          <label class="checkbox-pill">
            <input type="checkbox" name="weekDays" value="SUN">
            SUN
          </label>
          
        </div>
      </div>
      <div class="form-row">
        <label class="form-label" for="cv-month-days">On month days</label>
        <input class="console-input" type="text" id="cv-month-days" name="monthDays"
               placeholder="1,15" value="">
        <p class="form-hint">Comma-separated days of the month (1–31). Combine with week days for an intersection, or leave both empty to fire daily at the time above.</p>
      </div>
    </div>
    <div class="form-row" data-show="$delayType === 'dynamic'">
      <label class="form-label" for="cv-dynamic-key">Payload key</label>
      <input class="console-input console-input-mono" type="text" id="cv-dynamic-key" name="dynamicKey"
             placeholder="payload.sendAt" value="">
      <p class="form-hint">Dot-path into the trigger payload (e.g. <code>payload.sendAt</code>) holding an ISO-8601 timestamp to wait until, or an <code>{"amount":N,"unit":"hours"}</code> object.</p>
    </div>
    
    