</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="minutes"
           data-attr:aria-selected="($delayUnit === &#34;minutes&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$delayUnit = &#34;minutes&#34;; $uiSelOpen_delay_unit = false; $uiSelFilter_delay_unit = &#39;&#39;"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $delayUnit = &#34;minutes&#34;; $uiSelOpen_delay_unit = false; $uiSelFilter_delay_unit = &#39;&#39; } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_delay_unit = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
