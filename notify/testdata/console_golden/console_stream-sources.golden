  <div class="console-content">
    <header class="console-topbar">
      <h1 class="console-topbar-title" title="Stream Sources">Stream Sources</h1>
      <form class="console-search" role="search" data-on:submit="evt.preventDefault()">
        <span class="console-search-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input type="search" class="console-search-input" name="q"
               placeholder="Search workflows, subscribers…"
               aria-label="Search the console" autocomplete="off">
        <kbd class="console-search-kbd" aria-hidden="true">⌘K</kbd>
      </form>
      <div class="console-topbar-utils">
        <div class="console-env" data-signals="{envMenuOpen: false}">
          <button type="button" class="console-env-trigger" aria-haspopup="menu"
                  data-attr:aria-expanded="$envMenuOpen ? 'true' : 'false'"
                  data-on:click="$envMenuOpen = !$envMenuOpen">
            <span class="console-env-dot" aria-hidden="true"></span>
            <span class="console-env-name">ULID</span>
            <span class="console-env-chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </button>
          <div class="console-env-menu" role="menu" data-show="$envMenuOpen">
            <p class="console-env-menu-head">Environment</p>
            <span class="console-env-menu-item is-active" role="menuitemradio" aria-checked="true">
              <span class="console-env-dot" aria-hidden="true"></span>
              ULID
            </span>
            <p class="console-env-menu-meta">org ULID</p>
            <div class="console-env-menu-sep" role="separator"></div>
            <form method="post" action="/console/logout" class="console-logout" role="none">
              <input type="hidden" name="csrf_token" value="CSRF">
              <button type="submit" class="console-env-menu-action" role="menuitem">Sign out</button>
            </form>
          </div>
        </div>
        <button type="button" id="theme-toggle" class="theme-toggle"
                data-theme-mode="system"
                aria-label="Theme: system (click to cycle)" title="Toggle theme">
          <span aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </span>
          <span class="theme-toggle-label">System</span>
        </button>
      </div>
    </header>

    <main class="console-main">
      
      
      

<section class="console-section" data-signals="{&#34;streamSourceNewOpen&#34;:false}">
  
<header class="page-header" data-component="page-header">
  <div class="page-header-title-row">
    <h1>Stream Sources</h1>
  </div>
  <p class="console-lede">Inbound webhook-push sources. External producers POST event batches into this environment&#39;s feed.</p>
  
  <ul class="page-header-tiles" role="list">
    
    <li class="page-header-tile tile-tone-default" data-tone="default">
      
      <span class="page-header-tile-count">0</span>
      <span class="page-header-tile-label">sources</span>
      
    </li>
    
  </ul>
  
</header>


  

  
  

  <div class="console-filter-bar">
    
    <button type="button" class="btn btn-primary" data-on:click="$streamSourceNewOpen = true">+ Add source</button>
    
  </div>

  
  <div id="stream-source-slideover">
    
    <div class="console-slideover" role="dialog" aria-modal="true" aria-labelledby="stream-source-create-heading"
         data-component="stream-source-create"
         data-show="$streamSourceNewOpen"
         data-on:keydown__window="evt.key === 'Escape' && ($streamSourceNewOpen = false)">
      <div class="console-slideover-header">
        <h2 id="stream-source-create-heading" class="console-card-title">Add stream source</h2>
        <button type="button" class="btn-icon console-slideover-close" aria-label="Close"
                data-on:click="$streamSourceNewOpen = false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>
      </div>
      <form method="POST" action="/console/stream-sources">
        <input type="hidden" name="csrf_token" value="CSRF">
        <div class="form-row">
          <label class="form-label" for="new-stream-source-name">Name *</label>
          <input class="console-input" type="text" id="new-stream-source-name" name="name"
                 placeholder="token-relay" required aria-required="true" autofocus>
          <p class="form-hint">Lowercase letters, numbers, hyphens, and underscores.</p>
        </div>
        <div class="form-row">
          <label class="form-label" for="new-stream-source-topic">Topic *</label>
          <input class="console-input" type="text" id="new-stream-source-topic" name="topic"
                 placeholder="agent.tokens" required aria-required="true">
          <p class="form-hint">Dot-separated tokens (letters, numbers, <code>_</code>, <code>-</code>). This is the topic your producers publish under and your consumers subscribe to; batches may extend it with a dot suffix.</p>
        </div>
        <div class="console-slideover-actions">
          <button type="button" class="btn btn-outline" data-on:click="$streamSourceNewOpen = false">Cancel</button>
          <button type="submit" class="btn btn-primary">Create source</button>
        </div>
      </form>
    </div>
    
  </div>

  
  <div data-on-load="@get('/console/api/fragments/stream-sources-list')">
    
<div id="stream-sources-tbody" data-component="stream-sources-tbody">
  
  
<div class="console-empty-state" data-component="empty-state">
  
  
  
  <span class="console-empty-state-icon" data-kind="unplug" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 5 3-3M2 22l3-3m4.5-12L7 9.5a2.12 2.12 0 0 0 0 3L9 14.5a2.12 2.12 0 0 0 3 0l2.5-2.5m0 0 2.5-2.5a2.12 2.12 0 0 0 0-3L15 4a2.12 2.12 0 0 0-3 0L9.5 6.5M7 12l-2 2m12-2 2 2"/></svg>
</span>
  
  
  <h2 class="console-empty-state-title">No stream sources yet</h2>
  <p class="console-empty-state-description">Create a source to let an external producer POST event batches into this environment&#39;s feed.</p>
  
</div>

  
</div>

  </div>
</section>

    </main>
  </div>
  <div id="toast-outlet">
<div id="console-toast" class="console-toast"
     role="status" aria-live="polite"></div>
</div>
</body>
</html>