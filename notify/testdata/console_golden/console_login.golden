<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in — notify console</title>
  <link rel="stylesheet" href="/console/assets/app.623890b23e51.css">
</head>
<body class="console-login-body">
  <main class="console-login-card">
    
    <div class="console-brand console-login-brand">
      <span class="console-name">noti<span class="console-name-accent">.fy</span><span class="console-name-scheme">://</span></span>
    </div>
    <h1>Sign in</h1>
    <p class="console-lede">
      Paste an environment API key to open the operator console.
    </p>
    
    <form method="post" action="/console/login">
      
      <input type="hidden" name="csrf_token" value="CSRF">
      <label for="api_key">API key</label>
      <div class="console-secret-field">
        <input type="password" id="api_key" name="api_key"
               autocomplete="off" autofocus required
               placeholder="paste your API key">
        <button type="button" id="api_key_toggle" class="console-secret-toggle"
                aria-pressed="false" aria-controls="api_key"
                aria-label="Show API key">Show</button>
      </div>
      <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
    <script>
      
      
      (function () {
        var btn = document.getElementById("api_key_toggle");
        var input = document.getElementById("api_key");
        if (!btn || !input) return;
        btn.addEventListener("click", function () {
          var show = input.type === "password";
          input.type = show ? "text" : "password";
          btn.setAttribute("aria-pressed", show ? "true" : "false");
          btn.setAttribute("aria-label", show ? "Hide API key" : "Show API key");
          btn.textContent = show ? "Hide" : "Show";
        });
      })();
    </script>
    <p class="console-login-hint">
      Keys are minted by <code class="console-mono">notify bootstrap</code>.
      The session lives in an encrypted cookie scoped to /console.
    </p>
  </main>
</body>
</html>