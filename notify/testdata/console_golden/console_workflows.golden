          <span class="theme-toggle-label">System</span>
        </button>
      </div>
    </header>

    <main class="console-main">
      
      
      

<section class="console-section"
         data-store='{"wfFilter":&#34;&#34;,"wfStatus":&#34;&#34;,"wfConfirmDelete":"","wfNewTrigger":&#34;&#34;,"wfNewTriggerTouched":false}'
         data-signals="{&#34;wfTab&#34;:&#34;editor&#34;,&#34;workflowNewOpen&#34;:false}">
  
<header class="page-header" data-component="page-header">
  <div class="page-header-title-row">
    <h1>Workflows</h1>
  </div>
  <p class="console-lede">All notification workflows in this environment.</p>
  
  <ul class="page-header-tiles" role="list">
    
    <li class="page-header-tile tile-tone-default" data-tone="default">
      
      <span class="page-header-tile-count">1</span>
      <span class="page-header-tile-label">workflows</span>
      
    </li>
    
  </ul>
  
</header>


  <div class="console-filter-bar">
    <input id="wf-search"
           type="search"
           class="console-input"
           placeholder="Search by name or identifier"
           value=""
           data-bind="wfFilter"
           data-on:input__debounce.300ms="@get('/console/api/fragments/workflows-list')"
           aria-label="Search workflows">
    
<div class="ui-select" id="wf-status" data-signals="{uiSelOpen_wf_status: false, uiSelFilter_wf_status: &#39;&#39;}"
     data-on:click__outside="$uiSelOpen_wf_status = false">

  

  <button type="button" class="ui-select-trigger" id="wf-status-trigger"
          aria-haspopup="listbox" aria-controls="wf-status-popover"
          data-attr:aria-expanded="$uiSelOpen_wf_status ? &#39;true&#39; : &#39;false&#39;"
          data-on:click="$uiSelOpen_wf_status = !$uiSelOpen_wf_status"
          data-on:keydown="if (evt.key === &#39;Escape&#39;) { $uiSelOpen_wf_status = false } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $uiSelOpen_wf_status = true; const opts = Array.from(evt.target.closest(&#39;.ui-select&#39;).querySelectorAll(&#39;.ui-select-option&#39;)); const o = opts.find(el =&gt; el.style.display !== &#39;none&#39;); if (o) requestAnimationFrame(() =&gt; o.focus()) }"
          data-on:keydown__window="evt.key === &#39;Escape&#39; &amp;&amp; ($uiSelOpen_wf_status = false)">
    <span class="ui-select-trigger-label" data-text="$wfStatus === &#34;active&#34; ? &#34;Active&#34; : ($wfStatus === &#34;inactive&#34; ? &#34;Inactive&#34; : (&#34;All statuses&#34;))">All statuses</span>
    <span class="ui-select-trigger-chevron" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</span>
  </button>

  
  <div class="ui-select-popover" id="wf-status-popover" role="listbox"
       aria-label="All statuses"
       data-show="$uiSelOpen_wf_status">

    

    <div class="ui-select-options">
      
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value=""
           data-attr:aria-selected="($wfStatus === &#34;&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$wfStatus = &#34;&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;)"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $wfStatus = &#34;&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;) } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_wf_status = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">All statuses</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$wfStatus === &#34;&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="active"
           data-attr:aria-selected="($wfStatus === &#34;active&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$wfStatus = &#34;active&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;)"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $wfStatus = &#34;active&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;) } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_wf_status = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Active</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$wfStatus === &#34;active&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      <div class="ui-select-option" role="option" tabindex="0"
           data-value="inactive"
           data-attr:aria-selected="($wfStatus === &#34;inactive&#34;) ? &#39;true&#39; : &#39;false&#39;"
           
           data-on:click="$wfStatus = &#34;inactive&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;)"
           data-on:keydown="if (evt.key === &#39;Enter&#39; || evt.key === &#39; &#39;) { evt.preventDefault(); $wfStatus = &#34;inactive&#34;; $uiSelOpen_wf_status = false; $uiSelFilter_wf_status = &#39;&#39;; @get(&#39;/console/api/fragments/workflows-list&#39;) } else if (evt.key === &#39;ArrowDown&#39; || evt.key === &#39;ArrowUp&#39;) { evt.preventDefault(); const dir = evt.key === &#39;ArrowDown&#39; ? &#39;nextElementSibling&#39; : &#39;previousElementSibling&#39;; let n = evt.target[dir]; while (n &amp;&amp; (!n.classList.contains(&#39;ui-select-option&#39;) || n.style.display === &#39;none&#39;)) { n = n[dir] } if (n) n.focus() } else if (evt.key === &#39;Escape&#39;) { $uiSelOpen_wf_status = false; const t = evt.target.closest(&#39;.ui-select&#39;).querySelector(&#39;.ui-select-trigger&#39;); if (t) t.focus() }">
        <span class="ui-select-option-label">Inactive</span>
        <span class="ui-select-option-check" aria-hidden="true"
              data-show="$wfStatus === &#34;inactive&#34;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
</span>
      </div>
      
      
    </div>
  </div>
</div>

    
    <button type="button" class="btn btn-outline"
            data-show="$wfFilter !== '' || $wfStatus !== ''"
            data-on:click="$wfFilter = ''; $wfStatus = ''; $wfConfirmDelete = ''; @get('/console/api/fragments/workflows-list')">Reset</button>
    
    <button type="button" class="btn btn-primary" data-on:click="$workflowNewOpen = true">+ New workflow</button>
    
  </div>

  
  <div id="workflow-create-slideover" data-component="workflow-create"
       data-show="$workflowNewOpen"
       data-on:keydown__window="evt.key === 'Escape' && ($workflowNewOpen = false)">
    

    <div class="console-slideover" role="dialog" aria-modal="true" aria-labelledby="wf-create-heading">
      <div class="console-slideover-header">
        <h2 id="wf-create-heading" class="console-card-title">Create workflow</h2>
        <button type="button" class="btn-icon console-slideover-close" aria-label="Close"
                data-on:click="$workflowNewOpen = false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>
      </div>

      
      <a class="btn btn-outline wf-create-ai-link" href="/console/workflows/ai"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 9.2 8.6 2 9.2l5.5 4.7L5.8 21 12 17l6.2 4-1.7-7.1L22 9.2l-7.2-.6z"/></svg>
 Build with AI</a>

      

      <form method="POST" action="/console/api/workflows">
        <input type="hidden" name="csrf_token" value="CSRF">
        <div class="form-row">
          <label class="form-label" for="new-wf-name">Name *</label>
          
          <input class="console-input" type="text" id="new-wf-name" name="name"
                 value=""
                 data-on:input="!$wfNewTriggerTouched && ($wfNewTrigger = evt.target.value.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9_-]/g, ''))"
                 placeholder="Welcome Email" required aria-required="true" autofocus>
        </div>
        <div class="form-row">
          <label class="form-label" for="new-wf-trigger">Trigger identifier *</label>
          <input class="console-input console-input-mono" type="text" id="new-wf-trigger"
                 name="trigger_identifier" value="" placeholder="welcome-email"
                 data-bind="wfNewTrigger"
                 data-on:input="$wfNewTriggerTouched = true"
                 pattern="[a-z0-9_-]+" title="lowercase letters, digits, hyphens, underscores" required aria-required="true">
        </div>
        <div class="console-slideover-actions">
          <button type="button" class="btn btn-outline" data-on:click="$workflowNewOpen = false">Cancel</button>
          <button type="submit" class="btn btn-primary">Create workflow</button>
        </div>
      </form>
    </div>
    
  </div>

  
  <div id="workflow-duplicate-slideover">
    
  </div>

  
  <div class="console-table-wrap">
    <table class="console-table" aria-label="Workflows">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Status</th>
          <th scope="col">Steps</th>
          <th scope="col">Updated</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      
<tbody id="workflows-tbody">
  
  
  
<tr class="console-table-row" data-component="workflow-row" onclick="location.href='\/console\/workflows\/welcome-flow'" style="cursor:pointer">
  <td class="wf-col-name">
    <a class="wf-name-link" href="/console/workflows/welcome-flow" title="Welcome flow">Welcome flow</a>
    <span class="wf-trigger-id" onclick="event.stopPropagation()">
      <code class="wf-trigger-id-text">welcome-flow</code>
      <button type="button"
              class="btn-icon"
              title="Copy trigger identifier"
              aria-label="Copy welcome-flow"
              data-on:click="navigator.clipboard.writeText(&#39;welcome-flow&#39;)">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>

      </button>
    </span>
  </td>
  <td class="wf-col-status">
    
    <span class="chip chip-success" aria-label="active">Active</span>
    
  </td>
  <td class="wf-col-steps">
    <span class="chip-strip" role="list" aria-label="steps">
      
      <span class="chip chip-step chip-step--in_app" role="listitem">in_app</span>
      
      
    </span>
  </td>
  <td class="wf-col-updated">just now</td>
  <td class="wf-col-actions" onclick="event.stopPropagation()">
    
    
    <div class="wf-kebab">
      <button type="button" class="btn-icon" aria-label="Actions" onclick="this.nextElementSibling.classList.toggle('is-open')"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
</button>
      <div class="wf-kebab-menu">
        <a class="wf-kebab-item" href="/console/workflows/welcome-flow/activity">Activity</a>
        <a class="wf-kebab-item" href="/console/workflows/welcome-flow/test">Test</a>
        <a class="wf-kebab-item" href="/console/workflows/welcome-flow/duplicate">Duplicate</a>
        
        <a class="wf-kebab-item wf-kebab-item--danger"
           data-on:click="$wfConfirmDelete = 'welcome-flow'; @get('/console/api/fragments/workflows-list')">Delete</a>
      </div>
    </div>
    
    
  </td>
</tr>

  
  
</tbody>

<p id="wf-footer-note" class="wf-footer-note">1 of 1 workflows · click a row to open the editor</p>

    </table>
  </div>
  
  <p id="wf-footer-note" class="wf-footer-note">1 of 1 workflows · click a row to open the editor</p>
</section>

    </main>
  </div>
  <div id="toast-outlet">
<div id="console-toast" class="console-toast"
     role="status" aria-live="polite"></div>
</div>
</body>
</html>