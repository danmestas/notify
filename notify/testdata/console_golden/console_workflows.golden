      <div class="console-topbar-utils">
        <div class="console-env" data-signals="{envMenuOpen: false}">
          <button type="button" class="console-env-trigger" aria-haspopup="menu"
                  data-attr:aria-expanded="$envMenuOpen ? 'true' : 'false'"
                  data-on:click="$envMenuOpen = !$envMenuOpen">
